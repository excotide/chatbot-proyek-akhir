# Salin ke .env lalu isi
# Provider pesan: openwa (prototipe) atau cloud_api (Meta resmi, butuh verifikasi bisnis)
MESSAGING_PROVIDER=openwa

# --- OpenWA ---
OPENWA_BASE_URL=http://localhost:2785/api
OPENWA_API_KEY=
OPENWA_WEBHOOK_SECRET=
OPENWA_SESSION_NAME=pa-bot
# diisi otomatis oleh scripts/setup_openwa.py
OPENWA_SESSION_ID=
# alamat backend dilihat dari dalam container Docker
BACKEND_WEBHOOK_URL=http://host.docker.internal:8000/webhook/openwa

# --- Database (PostgreSQL di Docker, lihat ../database) ---
# password harus sama dengan POSTGRES_PASSWORD di ../database/.env
DATABASE_URL=postgresql+psycopg://pa_app:PASSWORD@127.0.0.1:5434/chatbot_pa

# --- Meta Cloud API (nanti, setelah verifikasi bisnis) ---
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=

# --- LLM ---
# ollama (lokal) | groq (cloud; isi chat dan potongan KB dikirim ke Groq)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
# GROQ_API_KEY ditaruh di Proyek PA/.env
GROQ_MODEL=openai/gpt-oss-120b
